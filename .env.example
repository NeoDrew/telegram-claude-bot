# Copy to .env (gitignored, chmod 600) and fill in the three required values.
# Everything else is optional: leave it out and the default applies.
# Any of these can also be set as an environment variable, which wins.

# ---- required --------------------------------------------------------------

# From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (the owner). Get it from getUpdates after
# messaging the bot once. The owner is allowed in every chat.
TELEGRAM_CHAT_ID=

# Long-lived OAuth token for headless claude runs: `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- optional --------------------------------------------------------------

# Extra Telegram user ids trusted in EVERY chat (comma or space separated).
# Prefer the per-chat Users menu instead, which scopes access to one chat.
#TELEGRAM_ALLOWED_IDS=

# The name the assistant uses for itself in chat. Default:
#BOT_NAME=Claude

# Optional persona or tone, appended to the system prompt as one line, e.g.
# "dry, concise and precise". Default: none (no persona).
#BOT_PERSONA=

# Claude model a chat uses until it picks one in the menu. Default:
#BOT_DEFAULT_MODEL=claude-opus-5-5

# launchd label of the listener job; the dashboard job adds "-dashboard".
# Must match the plist scripts/install.sh wrote. Default:
#BOT_LAUNCHD_LABEL=com.telegram-claude-bot

# Folder the cd menus list projects from, and a chat's default working
# directory. Default: your home folder. Example:
#BOT_PROJECTS_DIR=~/projects

# Single-host guard: if set, the listener refuses to start on any other
# machine (Telegram allows only one poller per bot token). Use the output of
# `hostname -s` or `scutil --get LocalHostName`. Default: no pinning.
#BOT_PRIMARY_HOST=

# Phone notifier the bot calls for alerts. Default: scripts/notify-cmd in
# this repo (install.sh also links it to ~/.local/bin/notify-cmd).
#NOTIFY_CMD=

# Python used to build .venv (screenshots and window capture). Default: the
# first python3 on PATH.
#BOT_PYTHON=

# Claude Code binary. Default: ~/.local/bin/claude, then claude on PATH.
#CLAUDE_BIN_OVERRIDE=

# Telegram Bot API base URL, for a self-hosted Bot API server (lifts the
# 20 MB download cap). Default: https://api.telegram.org
#TELEGRAM_API_BASE=

# Local metrics dashboard port. Default:
#BOT_DASHBOARD_PORT=8787

# Seconds one rate-limit alert suppresses duplicates for the same limit from
# other chats (every chat shares one Claude account). Default:
#RL_ALERT_DEDUP_S=7200
